# ── DISCIPLINE env template ──
# Copy to .env.local for local dev:  cp .env.example .env.local
# In Vercel: Settings → Environment Variables → add the same keys.

# ── Database (required) ──
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trading_dashboard

# ── Auth (required) ──
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Local: http://localhost:3000 | Prod: https://<YOUR-APP>.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Market data ──
# Free key: https://finnhub.io — stocks/ETFs/forex. Crypto works without it (CoinGecko, no key).
FINNHUB_KEY=

# ── Telegram bot (optional — required only for /portfolio in Telegram) ──
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-def...
# Bot username WITHOUT @, e.g. discipline_portfolio_bot (enables one-tap t.me link button)
TELEGRAM_BOT_USERNAME=
# Optional shared secret sent as ?secret_token= when setting webhook. Must match x-telegram-bot-api-secret-token.
TELEGRAM_WEBHOOK_SECRET=any-random-string-123
